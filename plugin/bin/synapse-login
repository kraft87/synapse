#!/usr/bin/env sh
# synapse-login — `synapse login`: sign in, enroll this machine, wire its harnesses.
#
# Claude Code puts a plugin's bin/ on PATH inside sessions, so `! synapse-login` runs it
# with no LLM in the loop. It locates the CLI relative to itself and reads its config from
# ~/.synapse/config.json, so it needs NO environment variables and NO $CLAUDE_PLUGIN_ROOT.
# It prints a device code (github.com/login/device or your OIDC provider), then polls
# until you approve.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SCRIPT="$DIR/../scripts/synapse_cli.py"
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "synapse-login: need python3 or python on PATH" >&2
  exit 1
fi
exec "$PY" "$SCRIPT" login "$@"
