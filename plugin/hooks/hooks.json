{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/ingest_hook.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/ingest_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/skills_sync.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/skills_sync.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/config_sync.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/config_sync.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/git_feeder.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/git_feeder.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" \"$CLAUDE_PLUGIN_ROOT/scripts/board_block.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/board_block.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/ingest_hook.py\" --catchup; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/ingest_hook.py\" --catchup",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/remember_spool.py\" session-start; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/remember_spool.py\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/private_mode.py\" --session-end; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/private_mode.py\" --session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/recall_nudge.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/recall_nudge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_synapse_synapse__(recall|recall_full_turns)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/recall_feedback_nudge.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/recall_feedback_nudge.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__remember$",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/remember_spool.py\" post-tool-use; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/remember_spool.py\" post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(recall|recall_full_turns|recall_feedback|fetch_session|remember)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] && . \"$CLAUDE_PLUGIN_ROOT/bin/synapse-python\" --quiet \"$CLAUDE_PLUGIN_ROOT/scripts/self_session_inject.py\"; exec python3 \"$CLAUDE_PLUGIN_ROOT/scripts/self_session_inject.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
