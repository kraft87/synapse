# Synapse configuration. Copy to .env and fill in. See ARCHITECTURE.md §13 for the full list.
# Prefer a ready-made variant? examples/env/ has one complete .env per deployment
# shape: voyage.env (default), local.env (no signups), openrouter.env (no Claude sub).

# --- Required ---
# Password for the bundled Postgres. Compose passes it to the postgres service
# as POSTGRES_PASSWORD (applied at first initdb only) — it MUST match the
# password embedded in SYNAPSE_DB_URL below; change both together.
SYNAPSE_DB_PASSWORD=CHANGEME
# Postgres DSN (psycopg3-style) the app services connect with. Host `postgres`
# is the compose service name (right for the bundled stack); use
# `localhost:5432` instead when running scripts on the host. The password must
# equal SYNAPSE_DB_PASSWORD above.
SYNAPSE_DB_URL=postgresql://synapse:CHANGEME@postgres:5432/synapse
# Shared bearer for this instance. REQUIRED: since schema 054 what a caller is
# served depends on WHICH credential it presents, and with no machine token the
# server has no credential to check — every caller resolves to "unknown" and is
# served nothing. Generate one:
#     openssl rand -hex 32
# Then give the first machine its own device token (prints one, once):
#     docker compose exec mcp-server synapse-admin bootstrap "<label>"
# and store THAT on the machine with `synapse login --token`.
# (Dev/stdio only: SYNAPSE_ALLOW_OPEN=1 lets the server boot without one — it
# then serves every caller `restricted`, i.e. nothing.)
SYNAPSE_MACHINE_TOKEN=CHANGEME
# Voyage AI key (embeddings + rerank — the default backend; can stay blank if
# you configure the alternative embedding/rerank backends below).
VOYAGE_API_KEY=
# Auth for the extraction LLM (the Claude Code CLI that ships inside claude-agent-sdk, pinned by uv.lock).
# Either variable works; if both are set, the subscription token wins:
#   CLAUDE_CODE_OAUTH_TOKEN — Claude Pro/Max subscription OAuth token
#                             (`claude setup-token`); no per-token billing.
#   ANTHROPIC_API_KEY       — pay-per-token API key from console.anthropic.com.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- Owner identity (optional, recommended) ---
# Canonical name for YOUR identity hub in the knowledge graph. Extracted
# mentions of "User" / "the user" / any alias below all resolve to this one
# entity instead of fragmenting. Default: "User".
#   SYNAPSE_OWNER_NAME=Sam
# Extra spellings that should also resolve to the hub (comma-separated —
# full name, nicknames):
#   SYNAPSE_OWNER_ALIASES=Sam Smith, sammy
# Project slugs (beyond jobs/personal/email-templates) whose content defaults
# to the personal graph rather than technical:
#   SYNAPSE_PERSONAL_PROJECTS=
# The personal scope is the split between a "personal" graph (life: family,
# health, job search) and the default "technical" one, plus the same label on
# timeline events. Set 0 to switch it off: every entity, fact and event then
# lands in the single technical graph and domain, and a recall asking for
# "personal" is answered from it. Recommended for work-only deployments, where
# the split just hides technical facts the personal regex caught. It changes
# routing from here on; rows already written keep the group they have.
#   SYNAPSE_PERSONAL_SCOPE=1
# Your IANA timezone. Conversation timestamps are stored in UTC; this decides which
# calendar day a turn belongs to (the date "today"/"yesterday" resolve against, and
# the date recall shows). Default America/Toronto.
#   SYNAPSE_TIMEZONE=America/Toronto

# --- Extraction LLM (optional) ---
# Backend for the extraction LLM: claude-code (default; Agent SDK via the token
# above) or openai (any OpenAI-compatible /chat/completions endpoint — OpenRouter,
# Ollama, vLLM). Extraction quality is tuned and validated on Claude Haiku; other
# models are unvalidated.
SYNAPSE_LLM_PROVIDER=claude-code
# Only used when SYNAPSE_LLM_PROVIDER=openai:
SYNAPSE_LLM_BASE_URL=https://openrouter.ai/api/v1
SYNAPSE_LLM_API_KEY=
# OpenRouter only: provider slugs to prefer, comma-separated ("fireworks,deepinfra"), or
# "auto" to rank the model's providers cheapest-first from OpenRouter's live listing.
#SYNAPSE_OPENROUTER_PROVIDERS=
# Global model override: every stage uses this id unless a per-stage
# override (below) names something else. LEAVE IT UNSET unless you mean it —
# every stage already has a working default, and the two providers spell the
# same model differently:
#   claude-code -> the CLI's own name, e.g. claude-haiku-4-5
#   openai      -> the provider's routed id, e.g. anthropic/claude-haiku-4.5
# A slashed id under claude-code is rejected by the CLI ([claude-code:
# unrecognized_model], empty output), which surfaces as every extraction stage
# failing with "no JSON object in response". The server refuses it up front now.
#SYNAPSE_LLM_MODEL=anthropic/claude-haiku-4.5   # openai provider only
# Per-stage model overrides (all optional; fall back to SYNAPSE_LLM_MODEL,
# then the stage default). Point cheap binary-decision stages at a smaller/
# local model independently of extraction:
#   SYNAPSE_EXTRACTOR_MODEL=      # KG fact/entity extraction
#   SYNAPSE_TIMELINE_MODEL=       # timeline event gate
#   SYNAPSE_PREFERENCES_MODEL=    # preferences gate
#   SYNAPSE_DEDUP_MODEL=          # entity/fact duplicate confirms
#   SYNAPSE_CONTRADICTION_MODEL=  # contradiction confirms
#   SYNAPSE_EDGE_DATES_MODEL=     # fact temporal-bounds extraction
#   SYNAPSE_SKILLS_JUDGE_MODEL=   # dream skills + config lane judges (default Opus)
#   SYNAPSE_SKILLS_DRAFT_MODEL=   # dream skills lane SKILL.md drafts (default Opus)
#   SYNAPSE_NOTES_CURATE_MODEL=   # notes lane: nightly curation of the board
#   SYNAPSE_NOTES_CONFIRM_MODEL=  # remember(): write-time duplicate/correction judge
#   SYNAPSE_CONTEXTUALIZE_MODEL=  # poller: context prefixes of captured web chunks

# --- Embeddings + rerank (optional) ---
# Embedding backend: voyage (default; uses VOYAGE_API_KEY above) or openai (any
# OpenAI-compatible POST /embeddings endpoint — OpenAI, Ollama, TEI, Infinity, vLLM).
# IMPORTANT: the embedding width is fixed at the database's FIRST BOOT (the schema's
# vector/halfvec columns are provisioned at SYNAPSE_EMBED_DIMS, default 2048). To run
# a non-2048-dim model, set SYNAPSE_EMBED_DIMS before the first `docker compose up`;
# an existing database keeps the dims+model it was provisioned with (recorded in
# synapse_meta) and the server fails loudly on a mismatch.
#SYNAPSE_EMBED_PROVIDER=voyage
#SYNAPSE_EMBED_BASE_URL=
#SYNAPSE_EMBED_API_KEY=
#SYNAPSE_EMBED_MODEL=
#SYNAPSE_EMBED_DIMS=2048
# Send the OpenAI `dimensions` request parameter: on by default only for text-embedding-3
# models; =1 forces it on, =0 off for a server that rejects unknown parameters.
#SYNAPSE_EMBED_SEND_DIMS=
# Rerank backend: voyage (default) | http (TEI/Infinity/Cohere-compatible POST /rerank)
# | none (no rerank calls — recall serves the pre-rerank RRF fusion order; retrieval
# quality drops: the cross-encoder rerank leg is the active ingredient).
#SYNAPSE_RERANK_PROVIDER=voyage
#SYNAPSE_RERANK_BASE_URL=
#SYNAPSE_RERANK_API_KEY=
# For voyage this picks the Voyage cross-encoder (default rerank-3-lite; set
# rerank-2.5-lite to roll back); for http it's the served model id (required when
# the server hosts several).
#SYNAPSE_RERANK_MODEL=
# Abstention floor on the reranker's raw top score: below it, recall serves NO
# episodes for that call instead of the least-bad ones. The right value depends on
# the reranker (scores are not comparable across models): 0.60 is calibrated for
# the default rerank-3-lite (it blanks the same share of real recalls that 0.58 did
# on rerank-2.5-lite; use 0.58 if you roll back to rerank-2.5-lite). A floor tuned
# for one model family replayed on another (e.g. a local reranker) blanked 39-56% of
# results, so re-tune or zero it when you change SYNAPSE_RERANK_MODEL. Unset/0 = off.
# Every examples/env preset sets it.
#SYNAPSE_RECALL_FLOOR=0.60
# The web and notes buckets of recall() are gated the same way (an item is served only above
# its floor, so a bucket may serve nothing), and the right value is just as reranker-specific:
# 0.60 is the default, calibrated on rerank-2.5-lite (rerank-3-lite runs 0.02-0.04 higher).
# Set both to 0 when you change SYNAPSE_RERANK_MODEL to another family, until you re-tune
# them. 0 serves each bucket's top matches whatever they score. Every examples/env preset
# sets them.
#SYNAPSE_RECALL_WEB_FLOOR=0.60
#SYNAPSE_RECALL_NOTES_FLOOR=0.60

# Fully local, zero-signup recipe (the bundled `local-inference` compose profile).
# examples/env/local.env is this whole file with the recipe already applied; to do
# it by hand, run `docker compose --profile local-inference up -d` (or set
# COMPOSE_PROFILES below, which compose reads from .env) and set these BEFORE
# the database's first boot (see the dims note above):
#   SYNAPSE_EMBED_PROVIDER=openai
#   SYNAPSE_EMBED_BASE_URL=http://local-inference:7997
#   SYNAPSE_EMBED_MODEL=BAAI/bge-base-en-v1.5
#   SYNAPSE_EMBED_DIMS=768
#   SYNAPSE_RERANK_PROVIDER=http
#   SYNAPSE_RERANK_BASE_URL=http://local-inference:7997
#   SYNAPSE_RERANK_MODEL=BAAI/bge-reranker-base
# VOYAGE_API_KEY can then stay blank. Honest caveat: published retrieval quality
# was measured on the Voyage stack; the local models are a convenience floor.
# Compose itself reads this one from .env: it starts the local-inference service
# (off by default) as part of a plain `docker compose up -d`, so you don't have to
# pass --profile every time.
#COMPOSE_PROFILES=local-inference

# --- Common optional ---
# MCP streamable-HTTP / ingest port. Sets BOTH the server's listener and the
# compose-published host port, so changing it here is all you need when 8765
# is taken on your host.
MCP_PORT=8765
# Host port the bundled Postgres is published on, bound to 127.0.0.1 only (containers
# reach it via the service name regardless). Change when 5432 is taken on your host;
# compose.yml has a commented line to publish it on every interface for remote psql.
POSTGRES_HOST_PORT=5432
# Poller maintenance cadence, seconds: chunk rebuild, embedding and the stale-claim sweep.
POLL_INTERVAL_SECONDS=300
# Queue items one poller replica extracts at once (default 4). The one burst knob: raise it
# for a backlog instead of adding replicas; each worker holds its own Postgres connection.
#SYNAPSE_DRAIN_CONCURRENCY=4
# Nightly dream lanes (02:03 UTC). All three are ON by default; =0 turns one off.
#SKILLS_LANE_ENABLED=0
#CONFIG_LANE_ENABLED=0
#SYNAPSE_NOTES_LANE=0
# Sessions the skills / config lanes judge per run, oldest first; the rest wait for the next night.
#SKILLS_LANE_LIMIT=30
#CONFIG_LANE_LIMIT=30
# Project ids every dream detector skips (comma-separated; there is no built-in default).
#SKILLS_EXCLUDE_PROJECTS=
# Optional Discord webhook for the skills lane's nightly digest.
#SKILLS_DISCORD_WEBHOOK=
# Kill switches for the two per-turn extraction gates (a small LLM check on each turn, fail-soft).
# On by default; =0 stops that gate from running at all.
#SYNAPSE_TIMELINE_GATE=0
#SYNAPSE_PREFS_GATE=0
# Projects whose turns are dropped at ingest as throwaway test workspaces: exact names,
# comma-separated, REPLACING the defaults (axon-test, axon_test, test, tmp, scratch). Set it
# empty to turn the filter off.
#SYNAPSE_SCRATCH_PROJECTS=
# Skip the startup check (poller, server, dream) that the database has every non-optional migration.
#SYNAPSE_SCHEMA_CHECK=0
# Web research captured from the transcripts your agents already send (any agent, any web
# tool; recognised by shape, public pages only). OFF by default: set `on` after
# `synapse capture --dry-run` has shown what it would store.
#SYNAPSE_WEB_CAPTURE=off
# Your own capture rules: a directory of *.toml files (and the Python hooks they name) that
# teaches capture a source of yours, or overrides a shipped rule by name. Mount it into the
# mcp-server container (compose.yml has the volume line to uncomment); read at start. Rules
# run as code on the server: mount it read-only and keep only what you trust in it.
#SYNAPSE_CAPTURE_DIR=/capture-rules
# Telemetry emit only; leave blank to disable.
LOGFIRE_TOKEN=

# --- Auth (SYNAPSE_MACHINE_TOKEN is in the Required block above) ---
# Everything below is optional: it adds an interactive identity provider, which
# `synapse login` enrollment needs. A local instance with no IdP uses
# `synapse-admin bootstrap` instead (see the machine-token comment above).
# Public base URL of this instance (used for OAuth callbacks).
SYNAPSE_PUBLIC_URL=https://synapse.example.net
# Extra origins the dashboard's browser login may return its token to (LAN address, a second
# hostname): comma-separated scheme://host[:port]. The public URL above is always allowed.
#SYNAPSE_DASH_ORIGINS=
# GitHub OAuth app, for the claude.ai web connector and `synapse login`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to authenticate (fail-closed if OAuth is on and this is empty).
ALLOWED_GITHUB_USERS=
# Signing key for issued OAuth tokens; generate a random value.
SYNAPSE_OAUTH_SIGNING_KEY=
