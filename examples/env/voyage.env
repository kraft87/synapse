# Synapse .env: the Voyage stack (today's default).
#
#   cp examples/env/voyage.env .env
#
# WHAT IT IS FOR
#   The standard deployment. Voyage AI serves embeddings and rerank; the Claude
#   Code CLI baked into the image does extraction.
#
# ACCOUNTS YOU NEED
#   1. Voyage AI (https://www.voyageai.com) for VOYAGE_API_KEY.
#   2. Either a Claude Pro/Max subscription, for CLAUDE_CODE_OAUTH_TOKEN via
#      `claude setup-token`, or an ANTHROPIC_API_KEY from console.anthropic.com
#      (pay per token). No Claude subscription? Use openrouter.env instead.
#
# THE ONE THING YOU CANNOT CHANGE AFTER FIRST BOOT
#   The embedding width. SYNAPSE_EMBED_DIMS (2048 here) is baked into the
#   schema's vector columns the first time Postgres starts and recorded in
#   synapse_meta; the server then refuses to run against a mismatch. Changing
#   the width or the embedding model later means starting from an empty data
#   volume.
#
# Fill in every CHANGEME and every blank marked required below. `.env.example`
# stays the full annotated reference for every variable that exists.

# --- Required ---
# Password for the bundled Postgres. Compose passes it to the postgres service
# as POSTGRES_PASSWORD (applied at first initdb only): it MUST match the
# password embedded in SYNAPSE_DB_URL below; change both together.
SYNAPSE_DB_PASSWORD=CHANGEME
# Postgres DSN the app services connect with. Host `postgres` is the compose
# service name (right for the bundled stack); use `localhost:5432` instead when
# running scripts on the host. The password must equal SYNAPSE_DB_PASSWORD.
SYNAPSE_DB_URL=postgresql://synapse:CHANGEME@postgres:5432/synapse
# Shared bearer for this instance. Required: with no machine token every caller
# resolves to "unknown" and is served nothing. Generate one:
#     openssl rand -hex 32
# Then give the first machine its own device token (prints one, once):
#     docker compose exec mcp-server synapse-admin bootstrap "<label>"
SYNAPSE_MACHINE_TOKEN=CHANGEME
# Required here: Voyage AI key, used for both embeddings and rerank.
VOYAGE_API_KEY=
# Auth for the extraction LLM. Fill in ONE of these two. If both are set, the
# subscription token wins.
#   CLAUDE_CODE_OAUTH_TOKEN: Claude Pro/Max OAuth token (`claude setup-token`),
#                            no per-token billing. Required here unless you
#                            uncomment ANTHROPIC_API_KEY below.
CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# --- Extraction LLM ---
# claude-code runs the Claude Code CLI baked into the image, using the token
# above. Extraction quality is tuned and validated on Claude Haiku.
SYNAPSE_LLM_PROVIDER=claude-code
# Leave SYNAPSE_LLM_MODEL unset: every stage already has a working default.
# Under claude-code the id must be the CLI's own dashed spelling
# (claude-haiku-4-5); a slashed OpenRouter id is refused at startup.
#SYNAPSE_LLM_MODEL=

# --- Embeddings + rerank ---
# Voyage on both legs, which is what VOYAGE_API_KEY above pays for.
SYNAPSE_EMBED_PROVIDER=voyage
SYNAPSE_RERANK_PROVIDER=voyage
# Embedding width. Fixed at the database's FIRST BOOT (see the header). 2048 is
# voyage-4-large, the default model.
SYNAPSE_EMBED_DIMS=2048
# Model overrides. Leave these COMMENTED to get the defaults (voyage-4-large and
# rerank-2.5-lite): an empty value is not the same as an absent one, and a blank
# SYNAPSE_RERANK_MODEL is sent to Voyage as an empty model id.
#SYNAPSE_EMBED_MODEL=
#SYNAPSE_RERANK_MODEL=
# Abstention floor on the reranker's raw top score: below it, recall serves no
# episodes for that call rather than the least-bad ones. 0.58 is calibrated for
# rerank-2.5-lite; if you change SYNAPSE_RERANK_MODEL, set this to 0 until you
# have re-tuned it for the new model.
SYNAPSE_RECALL_FLOOR=0.58

# --- Owner identity (optional, recommended) ---
# Canonical name for YOUR identity hub in the knowledge graph, so extracted
# mentions of "User", "the user" and the aliases below resolve to one entity
# instead of fragmenting. Default: "User".
#SYNAPSE_OWNER_NAME=
# Extra spellings that also resolve to the hub (comma-separated: full name,
# nicknames).
#SYNAPSE_OWNER_ALIASES=
# Project slugs (beyond jobs/personal/email-templates) whose content defaults to
# the personal graph rather than the technical one.
#SYNAPSE_PERSONAL_PROJECTS=
# The personal scope splits the graph into "personal" (life) and "technical"
# (the default). Set 0 to switch it off and put everything in the technical
# graph. Recommended for work-only deployments.
#SYNAPSE_PERSONAL_SCOPE=1

# --- Common optional ---
# MCP streamable-HTTP / ingest port. Sets BOTH the server's listener and the
# compose-published host port, so changing it here is all you need when 8765
# is taken on your host.
MCP_PORT=8765
# Host port the bundled Postgres is published on (containers reach it via the
# service name regardless). Change when 5432 is taken on your host.
POSTGRES_HOST_PORT=5432
# Stop-hook transcript tail size, in raw records.
SYNAPSE_INGEST_TAIL=400
# Poller full-cycle cadence, seconds.
POLL_INTERVAL_SECONDS=300
# Telemetry emit only; leave blank to disable.
LOGFIRE_TOKEN=

# --- Auth (optional) ---
# Everything below adds an interactive identity provider, which `synapse-login`
# enrollment needs. A local instance with no identity provider uses
# `synapse-admin bootstrap` instead and can leave this whole block as it ships.
# Public base URL of this instance (used for OAuth callbacks).
SYNAPSE_PUBLIC_URL=https://synapse.example.net
# GitHub OAuth app, for the claude.ai web connector and `/synapse:login`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to authenticate (fail-closed if OAuth is
# on and this is empty).
ALLOWED_GITHUB_USERS=
# Signing key for issued OAuth tokens; generate a random value.
SYNAPSE_OAUTH_SIGNING_KEY=

# Per-stage model overrides, recall tuning and every other knob: see
# .env.example, the full annotated reference, and ARCHITECTURE.md section 13.
