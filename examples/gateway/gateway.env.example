# Synapse MCP gateway (docs/gateway.md). Copy, fill in, keep secrets OUT of git.
#
# Deliberately NOT the Synapse .env: the gateway needs no machine token, no DSN and no
# LLM keys. Its only Synapse credential is each caller's own device bearer.

SYNAPSE_GATEWAY_SYNAPSE_URL=http://127.0.0.1:8765
SYNAPSE_GATEWAY_HOST=127.0.0.1
SYNAPSE_GATEWAY_PORT=8766
# full (default): only full-trust devices get Synapse's skill:// resources (the upstream
# serves every skill to any bearer, so restricted devices get none through the gateway).
SYNAPSE_GATEWAY_SKILLS_TRUST=full

# Optional: the MCP services THIS deployment puts behind the gateway, and extra skill
# directories. Unset = Synapse memory + skills only. See gateway.example.json.
#SYNAPSE_GATEWAY_CONFIG_FILE=/etc/synapse-gateway/gateway.json

# Secrets referenced by the registry via "secret_env" (names are yours to choose):
#TRACKER_MCP_TOKEN=
