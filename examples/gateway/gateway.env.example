# Synapse MCP gateway (docs/gateway.md). Copy, fill in, and keep keys OUT of git:
# prefer the *_API_KEY_FILE form pointing at a secret file (chmod 600).
#
# Deliberately NOT the Synapse .env: the gateway needs no machine token, no DSN and no
# LLM keys. Its only Synapse credential is each caller's own device bearer.

SYNAPSE_GATEWAY_SYNAPSE_URL=http://127.0.0.1:8765
SYNAPSE_GATEWAY_HOST=127.0.0.1
SYNAPSE_GATEWAY_PORT=8766
# full (default): only full-trust devices get research tools. restricted: any approved device.
SYNAPSE_GATEWAY_RESEARCH_TRUST=full

# Exa — set the URL to enable. Put the key EITHER in a header OR via {api_key} in the URL,
# as the provider's hosted-MCP docs specify (the gateway assumes neither).
#SYNAPSE_GATEWAY_EXA_URL=https://exa-mcp.example/mcp
#SYNAPSE_GATEWAY_EXA_AUTH_HEADER=x-api-key
#SYNAPSE_GATEWAY_EXA_API_KEY_FILE=/run/secrets/exa_api_key

# Firecrawl — same two shapes; this line shows the URL-placeholder form.
#SYNAPSE_GATEWAY_FIRECRAWL_URL=https://firecrawl-mcp.example/{api_key}/mcp
#SYNAPSE_GATEWAY_FIRECRAWL_API_KEY_FILE=/run/secrets/firecrawl_api_key

# Optional bounds (seconds)
#SYNAPSE_GATEWAY_DISCOVERY_TIMEOUT=5
#SYNAPSE_GATEWAY_FAILURE_BACKOFF=30
#SYNAPSE_GATEWAY_AUTH_CACHE_TTL=30
